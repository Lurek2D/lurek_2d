# Build artifacts

/build/*
/target/
/dist/

# Runtime save data written by the engine during test runs
/save/

# Session and planning artifacts
/work/
/scratch/

# Generated tool output logs (regenerated by tools/gen_all_docs.py and audit scripts)
/logs/*
!/logs/data/
/logs/data/*
!/logs/data/README.md

# Local research and draft docs
/ideas/competition/

# Root diagnostics and runtime logs
/cargo_check_err.txt
/clippy_out.txt
/clippy_output.txt

# Python bytecode (all subdirectories)
**/__pycache__/
**/*.pyc
**/*.pyo

# VS Code extension — build outputs and generated files
extension/vscode/node_modules/
extension/vscode/dist/
extension/vscode/src/generated/
extension/vscode/*.vsix
extension/vscode/.vscode-test/
extension/vscode/node_modules/

# Transient test output logs and scratch directories
extension/vscode/.vscode-test/
tools/rag/rag_index.db
tools/rag/rag_index.duckdb
tools/rag/rag_index.duckdb.wal
tools/rag/rag_index.*.duckdb
tools/rag/rag_index.manifest.json
tools/rag/rag_index.lock
/lurek_2d_pages/
